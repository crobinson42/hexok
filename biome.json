{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noThisInStatic": "off",
        "noStaticOnlyClass": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/node_modules",
      "!**/.turbo",
      "!**/coverage",
      "!**/*.tsbuildinfo"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/kerf/src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../domain",
                      "../domain/**",
                      "../app",
                      "../app/**",
                      "../infra",
                      "../infra/**",
                      "../runtime",
                      "../runtime/**",
                      "../testing",
                      "../testing/**",
                      "kerf/domain",
                      "kerf/app",
                      "kerf/infra",
                      "kerf/runtime",
                      "kerf/testing"
                    ],
                    "message": "core cannot import other layers"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/kerf/src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../app",
                      "../app/**",
                      "../infra",
                      "../infra/**",
                      "../runtime",
                      "../runtime/**",
                      "../testing",
                      "../testing/**",
                      "kerf/app",
                      "kerf/infra",
                      "kerf/runtime",
                      "kerf/testing"
                    ],
                    "message": "domain can only import core"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/kerf/src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../infra",
                      "../infra/**",
                      "../runtime",
                      "../runtime/**",
                      "../testing",
                      "../testing/**",
                      "kerf/infra",
                      "kerf/runtime",
                      "kerf/testing"
                    ],
                    "message": "app can only import core and domain"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/kerf/src/infra/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../app",
                      "../app/**",
                      "../runtime",
                      "../runtime/**",
                      "../testing",
                      "../testing/**",
                      "kerf/app",
                      "kerf/runtime",
                      "kerf/testing"
                    ],
                    "message": "infra can only import core and domain"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/kerf/src/runtime/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../infra",
                      "../infra/**",
                      "../testing",
                      "../testing/**",
                      "kerf/infra",
                      "kerf/testing"
                    ],
                    "message": "runtime can only import core, domain, and app"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/kerf/src/testing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../infra",
                      "../infra/**",
                      "kerf/infra"
                    ],
                    "message": "testing can import core, domain, app, and runtime — not infra"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
