{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noThisInStatic": "off",
        "noStaticOnlyClass": "off"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/node_modules",
      "!**/.turbo",
      "!**/coverage",
      "!**/*.tsbuildinfo"
    ]
  },
  "overrides": [
    {
      // Temporary. `job.stop()` on line 47 floats a promise. The Redis adapter
      // migration owns this package. Delete this entry once that line is fixed.
      "includes": ["packages/schedule-coordinator-redis/src/cron-scheduler.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    }
  ]
}
