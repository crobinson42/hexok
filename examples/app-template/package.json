{
  "name": "@hexok/app-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/servers/http/main.js",
    "start:worker": "node dist/servers/worker.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo",
    "session:open": "node dist/servers/scripts/open-session.js"
  },
  "dependencies": {
    "@hexok/auth": "*",
    "@hexok/auth-jose": "*",
    "@hexok/auth-redis": "*",
    "@hexok/email": "*",
    "@hexok/email-mailgun": "*",
    "@hexok/email-resend": "*",
    "@hexok/logger": "*",
    "@hexok/logger-newrelic": "*",
    "@hexok/logger-sentry": "*",
    "@hexok/quarantine": "*",
    "@hexok/queue": "*",
    "@hexok/queue-redis": "*",
    "@hexok/schedule-coordinator": "*",
    "@hexok/schedule-coordinator-redis": "*",
    "@hexok/sms": "*",
    "@hexok/sms-twilio": "*",
    "@hexok/webhooks": "*",
    "@ts-pf/contract": "^0.2.2",
    "@ts-pf/protocol": "^0.2.1",
    "@ts-pf/server": "^0.4.2",
    "@ts-pf/server-http": "^0.3.2",
    "hexok": "*",
    "jose": "^6.2.17",
    "redis": "^6.3.0",
    "srvx": "^1.0.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@ts-pf/client": "^0.2.2",
    "@ts-pf/client-http": "^0.2.2"
  }
}
