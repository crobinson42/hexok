{
  "name": "@hexok/app-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/servers/http/main.js",
    "start:worker": "node dist/servers/worker.js",
    "start:ws": "node dist/servers/ws/main.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hexok/broadcast": "*",
    "@hexok/broadcast-redis": "*",
    "@hexok/email": "*",
    "@hexok/email-mailgun": "*",
    "@hexok/email-resend": "*",
    "@hexok/logger": "*",
    "@hexok/logger-newrelic": "*",
    "@hexok/logger-sentry": "*",
    "@hexok/quarantine": "*",
    "@hexok/queue": "*",
    "@hexok/queue-redis": "*",
    "@hexok/schedule-coordinator": "*",
    "@hexok/schedule-coordinator-redis": "*",
    "@hexok/sms": "*",
    "@hexok/sms-twilio": "*",
    "@ts-pf/contract": "^0.2.2",
    "@ts-pf/message": "^0.2.1",
    "@ts-pf/message-server": "^0.3.2",
    "@ts-pf/protocol": "^0.2.1",
    "@ts-pf/server": "^0.4.2",
    "@ts-pf/server-http": "^0.3.2",
    "@ts-pf/sse": "^0.2.2",
    "@ts-pf/stream": "^0.2.2",
    "hexok": "*",
    "redis": "^5.8.2",
    "srvx": "^1.0.7",
    "ws": "^8.22.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@ts-pf/client": "^0.2.2",
    "@ts-pf/client-http": "^0.2.2",
    "@ts-pf/message-client": "^0.2.2",
    "@types/ws": "^8.18.2"
  }
