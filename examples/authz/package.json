{
  "name": "@hexok/authz-example",
  "version": "0.0.1",
  "private": true,
  "description": "HTTP API that checks and lists access with @hexok/authz.",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
