{
  "name": "@hexok/auth",
  "version": "0.1.1",
  "description": "Credential verification for hexok: an Authenticator port, sessions, and a seam that resolves the app's own actor.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "hexok",
    "auth",
    "authentication",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/hexok.git",
    "directory": "packages/auth"
  },
  "homepage": "https://crobinson42.github.io/hexok/",
  "bugs": {
    "url": "https://github.com/crobinson42/hexok/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "hexok": "^2.2.6"
  }
}
