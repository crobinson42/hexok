{
  "name": "@hexok/authz-mongo",
  "version": "0.0.0",
  "description": "MongoDB adapters for the hexok authz ports.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "hexok",
    "authorization",
    "mongodb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/hexok.git",
    "directory": "packages/authz-mongo"
  },
  "homepage": "https://crobinson42.github.io/hexok/",
  "bugs": {
    "url": "https://github.com/crobinson42/hexok/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hexok/authz": "^0.0.0",
    "hexok": "^2.2.2"
  },
  "peerDependencies": {
    "mongodb": "^6 || ^7"
  },
  "devDependencies": {
    "@hexok/test-authz": "0.0.0",
    "mongodb": "^7.8.0"
  }
}
