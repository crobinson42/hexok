{
  "name": "hexok",
  "version": "0.0.1",
  "description": "A TypeScript kit for writing a clean-architecture backend as ordinary classes.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/hexok.git",
    "directory": "packages/hexok"
  },
  "homepage": "https://github.com/crobinson42/hexok#readme",
  "bugs": {
    "url": "https://github.com/crobinson42/hexok/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./infra": {
      "types": "./dist/infra/index.d.ts",
      "import": "./dist/infra/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "zod": "^4.1.5"
  }
}
