{
  "name": "@hexok/queue-redis",
  "version": "1.0.0",
  "description": "Redis Streams adapter for the hexok Queue port.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "hexok",
    "queue",
    "redis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crobinson42/hexok.git",
    "directory": "packages/queue-redis"
  },
  "homepage": "https://crobinson42.github.io/hexok/",
  "bugs": {
    "url": "https://github.com/crobinson42/hexok/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
