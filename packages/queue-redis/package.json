    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hexok/ioredis-lifecycle": "^1.0.0",
    "@hexok/queue": "^1.0.0",
    "hexok": "^2.2.2",
    "ioredis": "^6"
  },
  "devDependencies": {
    "@hexok/test-redis": "0.0.0"
  }
