{
  "name": "@hexok/test-authz",
  "version": "0.0.0",
  "private": true,
  "description": "Test utilities for hexok authz adapters: the reference scenario and an agreement suite.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
