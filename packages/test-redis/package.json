{
  "name": "@hexok/test-redis",
  "version": "0.0.0",
  "private": true,
  "description": "Test utilities for hexok Redis adapters: an outage proxy, a child Node runner, and a lifecycle conformance suite.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "vitest": "^5"
  },
  "devDependencies": {
    "ioredis": "^6",
    "vitest": "^5.0.5"
  }
}
